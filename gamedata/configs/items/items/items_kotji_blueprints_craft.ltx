; -------------------------------------------------------------------------------------------------
; Weapon blueprint
; This is a generalize weapon craft using a blueprint as base, blueprint only drop on enemy based
; their rank usually
;
; - novice, experienced = handgun, shotgun, submachinegun
; - professional, veteran = rifle, submachinegun
; - expert, master, legend = rifle, sniper
; - legend = unique
;
; what the material to craft
; gun = receiver + weapon frame + blueprint + repair_kit
; for receiver = all weapon part example for pm you need all their part regardless the condition 
; wpn_pm = prt_w_p_barrel_1 + prt_w_p_trigger_3 + prt_w_p_spring_1
;--------------------------------------------------------------------------------------------------

[kotji_blueprint_base]:prt_i_paper
icons_texture							        	   = ui\ui_kotji_modules
description			                                   = st_prt_i_paper_descr
inv_name			                                   = st_prt_i_paper
inv_name_short			                               = st_prt_i_paper
inv_grid_width			                               = 2
inv_grid_height			                               = 1
inv_grid_x			                                   = 0
inv_grid_y			                                   = 0
cost				                                   = 52
inv_weight			                                   = 0.01
attach_angle_offset		                               = -0.287979, 1.560923, 1.544060
attach_position_offset		                           = 0.096910, -0.013594, 0.107925
attach_bone_name		                               = bip01_r_hand
auto_attach				                               = false
repair_part_bonus	 	                               = 0.01
snd_on_take								 		       = part
tier                                                   = 1

